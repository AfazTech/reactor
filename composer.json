{
    "name": "afaztech/reactor",
    "description": "Application skeleton for the Reactor PHP framework",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
    {
        "type": "path",
        "url": "../reactor-framework",
        "options": {
            "symlink": true
        }
    }
],
    "require": {
        "afaztech/reactor-framework": "dev-main"
    }
}